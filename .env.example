# Copia este archivo a .env.local para desarrollo (nunca subas .env.local a git).
# En Vercel, configura estas mismas variables en Project Settings > Environment Variables.

# URL pública del sitio (usada en metadata, sitemap y robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo destino de los mensajes del formulario de contacto
CONTACT_EMAIL_TO=contacto@cotambora.org

# Clave de API de Resend (https://resend.com) para el envío real de correos.
# Si se deja vacía, el endpoint de contacto solo valida y registra el
# mensaje en el log del servidor (modo desarrollo/sin proveedor configurado).
RESEND_API_KEY=
